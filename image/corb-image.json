{
  "arch": "x86_64",
  "distro": "alpine",
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "rootfsPackages": [
      "linux-virt",
      "bash",
      "ca-certificates",
      "curl",
      "git",
      "openssh-client",
      "ripgrep",
      "jq",
      "less",
      "nodejs",
      "npm",
      "github-cli",
      "tzdata"
    ]
  },
  "container": { "force": true, "runtime": "docker" },
  "rootfs": { "label": "corb-root", "sizeMb": 3072 },
  "env": { "LANG": "C.UTF-8", "CORB_IMAGE_KIND": "default" },
  "postBuild": {
    "copy": [
      { "src": "../guest/build/dropcap", "dest": "/usr/local/bin/dropcap" },
      { "src": "overlay/etc/corb/suid-allowlist.txt", "dest": "/etc/corb/suid-allowlist.txt" },
      { "src": "overlay/etc/corb/image.json", "dest": "/etc/corb/image.json" }
    ],
    "commands": [
      "npm i -g --ignore-scripts --omit=dev @earendil-works/pi-coding-agent@0.84.2",
      "addgroup -g 1000 agent && adduser -D -u 1000 -G agent -h /home/agent -s /bin/sh agent",
      "mkdir -p /work /home/agent/.pi /home/agent/sessions && chown -R 1000:1000 /home/agent /work",
      "rm -f /usr/bin/npm /usr/bin/npx /bin/su /usr/bin/su /usr/bin/sudo /usr/bin/doas /sbin/apk",
      "chmod 0755 /usr/local/bin/dropcap"
    ]
  }
}
