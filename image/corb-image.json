{
  "arch": "x86_64",
  "distro": "alpine",
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "rootfsPackages": [
      "linux-virt",
      "bash",
      "ca-certificates",
      "curl",
      "git",
      "openssh-client",
      "ripgrep",
      "jq",
      "less",
      "nodejs",
      "npm",
      "github-cli",
      "tzdata"
    ]
  },
  "container": { "force": true, "runtime": "docker" },
  "rootfs": { "label": "corb-root", "sizeMb": 3072 },
  "env": { "LANG": "C.UTF-8", "CORB_IMAGE_KIND": "default" },
  "init": { "rootfsInitExtra": "overlay/init-extra.sh" },
  "postBuild": {
    "copy": [
      { "src": "../guest/build/{arch}/dropcap", "dest": "/usr/local/bin/dropcap" },
      { "src": "../guest/build/{arch}/policygate", "dest": "/usr/local/libexec/policygate" },
      { "src": "overlay/etc/corb/suid-allowlist.txt", "dest": "/etc/corb/suid-allowlist.txt" },
      { "src": "overlay/etc/corb/image.json", "dest": "/etc/corb/image.json" }
    ],
    "commands": [
      "apk add --no-cache build-base linux-headers fuse3-dev fuse3-libs libstdc++ libgcc zstd-libs",
      "cd /tmp && curl -fsSL -o bindfs.tar.gz https://bindfs.org/downloads/bindfs-1.18.4.tar.gz && echo '1fedfcd082980180ccdd684478cc5308f4ea3fa541af12b5aef0b75fb0ec5b285009c4b783fc3cd5550505a83baf015e243f88eb322540d0f82e1952babc799a  bindfs.tar.gz' | sha512sum -c - && tar xzf bindfs.tar.gz",
      "cd /tmp/bindfs-1.18.4 && ./configure --prefix=/usr --sysconfdir=/etc --mandir=/usr/share/man --localstatedir=/var && make && make install",
      "rm -rf /tmp/bindfs.tar.gz /tmp/bindfs-1.18.4",
      "apk del build-base linux-headers fuse3-dev",
      "npm i -g --ignore-scripts --omit=dev @earendil-works/pi-coding-agent@0.84.2",
      "addgroup -g 1000 agent && adduser -D -u 1000 -G agent -h /home/agent -s /bin/sh agent",
      "mkdir -p /work /home/agent/sessions && chown -R 1000:1000 /home/agent /work",
      "rm -f /usr/bin/npm /usr/bin/npx /bin/su /usr/bin/su /usr/bin/sudo /usr/bin/doas /sbin/apk",
      "mv /usr/bin/git /usr/local/libexec/real-git && ln -s /usr/local/libexec/policygate /usr/local/bin/git",
      "if [ -x /usr/bin/gh ]; then mv /usr/bin/gh /usr/local/libexec/real-gh && ln -s /usr/local/libexec/policygate /usr/local/bin/gh; fi",
      "chmod 0755 /usr/local/bin/dropcap /usr/local/libexec/policygate"
    ]
  }
}
