{
  "name": "corb",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "corb": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "image"
  ],
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "@earendil-works/gondolin": "0.12.0",
    "smol-toml": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ssh2": "^1.15.5",
    "oxlint": "^1.80.0",
    "ssh2": "1.17.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
